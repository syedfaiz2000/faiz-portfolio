# Copy this file to ".env" and fill in your own EmailJS values.
# Get them from https://dashboard.emailjs.com
#
# Do not add quotes or spaces around the values.
# Restart the dev server (npm run dev) after changing this file.

# Email Services -> your service -> Service ID
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx

# Email Templates -> your template -> Template ID
# Template variables used: {{name}}, {{email}}, {{title}}, {{message}}
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx

# Account -> General -> Public Key
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx
